# Optional configuration for the PRIVATE ChatGPT plugin server.
# Copy to .env locally and edit there. Never upload .env or paste keys into chat.
# The local browser preview ignores these values and always uses demo mode.
PRISM_PLUGIN_ALLOW_LIVE=0

# Optional browser sign-in server (one private owner; no password is supplied).
# Set a unique passphrase of at least 16 characters locally before starting it.
PRISM_BROWSER_PASSWORD=
PRISM_BROWSER_ALLOW_LIVE=0
# PRISM_BROWSER_PORT=8797
# PRISM_BROWSER_DATA_DIR=/absolute/private/path/prism-browser
# Set only for an approved HTTPS reverse proxy, without a path or trailing slash:
# PRISM_BROWSER_ORIGIN=https://your-private-prism.example

# Add only the providers you intend to use. Model IDs must be available to you.
OPENAI_API_KEY=
PRISM_MODEL_OPENAI=
GEMINI_API_KEY=
PRISM_MODEL_GEMINI=
XAI_API_KEY=
PRISM_MODEL_GROK=
ANTHROPIC_API_KEY=
PRISM_MODEL_CLAUDE=

# Optional ABSOLUTE path. Omit to keep plugin data separate from standalone:
# PRISM_PLUGIN_DATA_DIR=/absolute/private/path/prism-chatgpt

# CONTROL_PLANE_API_KEY belongs to tunnel-client. Configure it separately in
# that process's local environment, not here or in a tool call.
